---
// Decorative cards with people from the user's circle; position, colors and tilt per card.
const cards = [
  {
    name: "Лена",
    note: "Подруга · сходить на выставку",
    class:
      "top-7.5 right-8.5 left-11 -rotate-5 bg-cobalt-700 text-cream lg:top-10 lg:right-5 lg:left-15",
    noteClass: "text-mist",
  },
  {
    name: "Дима",
    note: "Бывший коллега · кофе",
    class:
      "top-28 right-12.5 left-6 rotate-3 bg-cream text-cobalt-700 lg:top-40 lg:right-17.5 lg:left-2.5",
    noteClass: "text-cobalt-soft",
  },
  {
    name: "Марк",
    note: "Познакомились на мероприятии",
    class:
      "top-49.5 right-7.5 left-10 -rotate-2 bg-cobalt-900 text-cream lg:top-70 lg:right-0 lg:left-12.5",
    noteClass: "text-mist",
  },
];
---

<div
  class="relative mx-auto my-2 min-h-73 w-full max-w-hero-cards-sm flex-1 lg:my-0 lg:h-110 lg:max-w-hero-cards"
  aria-hidden="true"
>
  {
    cards.map((card) => (
      <div
        class:list={[
          "absolute flex h-21 items-center rounded-person px-5.5 lg:h-27.5 lg:rounded-person-lg lg:px-8",
          card.class,
        ]}
      >
        <div class="flex flex-col gap-1 lg:gap-1.5">
          <div class="text-person-name font-bold lg:text-person-name-lg">{card.name}</div>
          <div class:list={["text-person-note lg:text-person-note-lg", card.noteClass]}>
            {card.note}
          </div>
        </div>
      </div>
    ))
  }
</div>
